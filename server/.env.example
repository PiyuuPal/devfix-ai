# Copy to .env and fill in ONE key. Never commit .env.
# The first key found picks the provider: Anthropic → OpenRouter → OpenAI.
ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=sk-or-...
# OPENAI_API_KEY=sk-...

# Optional: force a provider (anthropic | openrouter | openai) and/or a model.
# Defaults: claude-opus-5-5 (anthropic), openai/gpt-6.1-sol (openrouter), gpt-6.1-sol (openai)
# AI_PROVIDER=openrouter
# AI_MODEL=anthropic/claude-sonnet-5.5

# PORT=3000
# Max /analyze requests per IP per 10 minutes
# RATE_LIMIT=20
