{
  "name": "devfix-react-native",
  "version": "0.1.0",
  "description": "Dev-only 'Explain with AI' for React Native & Expo runtime errors",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "lib",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test 'test/*.test.ts'",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-native": ">=0.79",
    "expo-constants": "*"
  },
  "peerDependenciesMeta": {
    "expo-constants": {
      "optional": true
    }
  },
  "keywords": [
    "react-native",
    "expo",
    "error",
    "debug",
    "ai",
    "claude",
    "devtools"
  ]
}
